# Cognito (backend/template.yaml の SAM デプロイ Outputs から取得)
# ブラウザ側でも使うため VITE_ プレフィックスが必要
VITE_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
VITE_COGNITO_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# AgentCore Runtime (agentcore/.cli/deployed-state.json や `agentcore status` から取得)
# ブラウザから直接 AgentCore Runtime を呼び出すため VITE_ プレフィックスが必要。
# 呼び出しには Cognito が発行した JWT (Inbound Auth で aud クレームを検証) が必須なため、
# ARN 自体がブラウザに見えても実害は小さい。
VITE_AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:xxxxxxxxxxxx:runtime/examAgent_MyAgent-xxxxxxxxxx
VITE_AGENT_RUNTIME_REGION=us-east-1
